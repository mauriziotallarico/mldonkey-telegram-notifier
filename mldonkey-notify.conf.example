# mldonkey-notify.conf — Configurazione notifiche Telegram per MLDonkey
# Copia questo file come mldonkey-notify.conf e compila i valori

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# === PATHS ===
MLDONKEY_INCOMING="/path/to/mldonkey/incoming/files"

# === TMDb (opzionale — per poster e metadata) ===
# Ottieni gratis da: https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# === SOTTOTITOLI ===
SUBTITLE_LANG="it"
SUBTITLE_ENABLED="true"

# === LOG ===
LOG_FILE="/var/log/mldonkey-notify.log"

# === OPZIONI ===
MEDIA_LOOKUP="true"
SEND_POSTER="true"
